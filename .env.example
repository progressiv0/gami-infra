# Every credential this repo's automation reads. Nothing here is ever
# committed with a real value.
#
#   cp .env.example .env      # then fill in real values
#   set -a; source .env; set +a
#
# Use exactly that `set -a` form before any terraform/ansible command.
# `export $(cat .env)` mangles values containing spaces and fails with a
# confusing "No closing quotation" much later — see docs/troubleshooting.md.
# Note it also cannot UNSET a variable you blanked here; open a new shell.
#
# .env is gitignored. Never commit it.


# --- Terraform (terraform/) ----------------------------------------------
# Used by: docs/terraform.md, docs/setup-server.md step 2

# Hetzner Cloud API token, with access to the two already-provisioned
# servers. Read via Terraform's own TF_VAR_<name> convention. Terraform only
# attaches networking/firewalls — it never creates or destroys servers.
TF_VAR_hcloud_token=

# Your admin IP(s) in CIDR notation, e.g. 203.0.113.4/32. The ONLY source
# allowed to reach SSH (22), the k3s API (6443), and the ArgoCD UI (30443).
# If your IP rotates you lose all three until you re-apply with the new CIDR.
TF_VAR_admin_ip_cidr=

# Hetzner Object Storage keys for Terraform's remote state backend
# (terraform/backend.tf). The bucket must already exist — the backend won't
# create it. Passed via `terraform init -backend-config=...`.
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=


# --- Ansible (ansible/) --------------------------------------------------
# Used by: docs/setup-server.md step 3, and every db-*.yml playbook

# The two servers' real public IPs — deliberately not committed, since this
# repo is public. ansible/inventory/production.yml reads them at run time.
#
# If these are unset, Ansible fails with the misleading error "hostname
# contains invalid characters" — the lookup returns an empty string rather
# than failing. Remember they don't cross a container/distrobox boundary
# unless exported before you entered.
GAMI_STAGING_IP=
GAMI_PROD_IP=

# Optional. Path to the SSH private key authenticating as `ops` (or `root`,
# on the very first run). Leave unset to fall back to ssh-agent and
# ~/.ssh/config discovery.
GAMI_SSH_PRIVATE_KEY_PATH=


# --- ArgoCD repo access --------------------------------------------------
# Used by: ansible/roles/argocd/tasks/repo-credentials.yml

# Only needed if THIS repo is private — ArgoCD (on staging) clones it to
# manage both clusters. A fine-grained PAT with read-only Contents access is
# enough. GAMI_INFRA_REPO_USERNAME can be anything non-empty (GitHub only
# checks the token) and defaults to "git".
#
# Leave both unset for a public repo: the task skips itself. Do NOT leave a
# stale token here for a public repo — ArgoCD prefers a matching credential
# over anonymous access, so a dead token turns a working clone into an auth
# failure ("revision main must be resolved"). See docs/troubleshooting.md.
GAMI_INFRA_REPO_TOKEN=
GAMI_INFRA_REPO_USERNAME=


# --- GHCR image pulls ----------------------------------------------------
# Used by: ansible/roles/image_pull_secret/ — see docs/image-pull-secret.md

# What the kubelet uses to pull ghcr.io/authenticmemory/gami-webapp.
# Needed whenever the GHCR *packages* are private — which is independent of
# whether this repo is public, since package visibility is its own GitHub
# setting. Applied to both clusters, into gami-staging and gami respectively.
#
# Leave unset only if the packages are public (verify with a logged-out
# `docker pull`); the role then skips itself and prints a warning.
GHCR_USERNAME=
GHCR_PAT=              # fine-grained PAT, read:packages only


# --- Production database backups -----------------------------------------
# Used by: a one-off kubectl command — see docs/database.md

# Hetzner Object Storage keys for production's Postgres backups (nightly
# base backup + continuous WAL → S3). Same bucket as Terraform state, under
# the postgres-backups/ prefix; use a separate key pair if you want backup
# access scoped independently.
#
# NOT read by any script here — these are pasted into a `kubectl create
# secret generic gami-postgres-backup-creds` command once, per
# docs/database.md. Listed so this file remains the single answer to "what
# credentials does operating this repo need at all."
# HETZNER_BACKUP_ACCESS_KEY_ID=
# HETZNER_BACKUP_ACCESS_SECRET_KEY=
