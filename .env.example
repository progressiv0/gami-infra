# Environment variables this repo's automation reads at run time — nothing
# here is ever committed with a real value. Copy this file to `.env`
# (already covered by the repo's general rule of never committing real
# credentials — `.env` itself should never be committed either) and
# `set -a; source .env; set +a` before running terraform/ansible commands,
# or export these directly in your shell/CI secrets store.
#
# Vars marked "(manual step)" aren't read automatically by any script here —
# they're pasted into a one-off `kubectl create secret` command from a
# README runbook. Listed here anyway so this file is the single place that
# answers "what credentials does operating this repo need at all."

# --- Terraform (terraform/) ---------------------------------------------

# Hetzner Cloud API token. Read by terraform/variables.tf's hcloud_token
# variable via Terraform's own TF_VAR_<name> convention.
TF_VAR_hcloud_token=

# Your admin IP(s), CIDR notation (e.g. 203.0.113.4/32) — the only source
# allowed to reach SSH (22) and the k3s API (6443) on either node.
TF_VAR_admin_ip_cidr=

# Hetzner Object Storage credentials for Terraform's remote state backend
# (terraform/backend.tf) — passed via `terraform init -backend-config=...`,
# see terraform/README.md.
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=

# --- Ansible (ansible/) --------------------------------------------------

# gami-staging's and gami-prod's real public IPs — deliberately not
# committed (see ansible/inventory/production.yml).
GAMI_STAGING_IP=
GAMI_PROD_IP=

# Optional. Path to the SSH private key that authenticates as the `ops`
# user (or `root`, on first run) against both servers. Leave unset to fall
# back to ssh-agent / ~/.ssh/config's normal key discovery.
GAMI_SSH_PRIVATE_KEY_PATH=

# --- ArgoCD repo access (ansible/roles/argocd/tasks/repo-credentials.yml) -

# Only needed if this repo (gami-infra) is a PRIVATE GitHub repo — ArgoCD
# (running on staging) needs credentials to clone it, since it's the source
# for every Application it manages on both clusters. Leave both unset for a
# public repo; the task skips itself entirely. A fine-grained PAT with
# read-only Contents access to this repo is enough — GAMI_INFRA_REPO_USERNAME
# can be anything non-empty (GitHub only checks the token) and defaults to
# "git" if unset.
GAMI_INFRA_REPO_TOKEN=
GAMI_INFRA_REPO_USERNAME=

# --- Manual, per-cluster, never automated (see the referenced README) ----

# base/README-image-pull-secret.md — `kubectl create secret docker-registry
# ghcr-pull-secret`, once per cluster. Not read by any script; listed here
# for visibility only.
# GHCR_USERNAME=
# GHCR_PAT=            # fine-grained PAT, read:packages only

# overlays/production/database/README-backup.md — `kubectl create secret
# generic gami-postgres-backup-creds`, production cluster only. Not read by
# any script; listed here for visibility only.
# HETZNER_BACKUP_ACCESS_KEY_ID=
# HETZNER_BACKUP_ACCESS_SECRET_KEY=