apiVersion: v1
kind: Secret
metadata:
  name: gami-infra-repo
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: {{ argocd_repo_url }}
  username: {{ gami_infra_repo_username }}
  password: {{ gami_infra_repo_token }}