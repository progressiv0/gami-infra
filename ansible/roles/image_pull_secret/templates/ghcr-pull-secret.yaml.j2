apiVersion: v1
kind: Secret
metadata:
  name: {{ image_pull_secret_name }}
  namespace: {{ image_pull_secret_namespace }}
type: kubernetes.io/dockerconfigjson
stringData:
  # Hand-built rather than shelled out to `kubectl create secret
  # docker-registry`: that would put the PAT in the node's process argv,
  # visible to anyone running ps during the apply. Rendering it into a
  # 0600 file instead keeps it out of the process table entirely.
  #
  # `auth` is base64("username:password") — the Docker config format
  # duplicates the credential there, and the kubelet reads that field, so
  # it is not optional despite username/password also being present.
  .dockerconfigjson: '{"auths":{"{{ image_pull_secret_registry }}":{"username":"{{ ghcr_username }}","password":"{{ ghcr_pat }}","auth":"{{ (ghcr_username ~ ":" ~ ghcr_pat) | b64encode }}"}}}'
