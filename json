apiVersion: v1
data:
  APP_BASE_URL: https://staging.authenticmemory.org
  AUTH_TRUST_HOST: "true"
  BOOTSTRAP_OPERATOR_EMAIL: tech@authenticmemory.org
  CORS_ALLOWED_ORIGIN: https://staging.authenticmemory.org
  NEXTAUTH_URL: https://staging.authenticmemory.org
  NODE_ENV: production
  SECURE_COOKIES: "true"
  SMTP_FROM: noreply@authenticmemory.org
  SMTP_FROM_NAME: Authentic Memory (staging)
  SMTP_HOST: smtp.example.com
  SMTP_PORT: "587"
  SMTP_SECURE: "false"
kind: ConfigMap
metadata:
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/sync-wave: "-1"
  name: gami-config
  namespace: gami-staging
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app: gami-webapp
  name: gami-webapp
  namespace: gami-staging
spec:
  ports:
  - name: http
    port: 3000
    targetPort: http
  selector:
    app: gami-webapp
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: gami-webapp
  name: gami-webapp
  namespace: gami-staging
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gami-webapp
  template:
    metadata:
      labels:
        app: gami-webapp
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: env
                operator: In
                values:
                - staging
            weight: 100
      containers:
      - env:
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              key: uri
              name: gami-postgres-app
        - name: NEXTAUTH_SECRET
          valueFrom:
            secretKeyRef:
              key: NEXTAUTH_SECRET
              name: gami-secrets
        - name: SMTP_USER
          valueFrom:
            secretKeyRef:
              key: SMTP_USER
              name: gami-smtp
              optional: true
        - name: SMTP_PASS
          valueFrom:
            secretKeyRef:
              key: SMTP_PASS
              name: gami-smtp
              optional: true
        envFrom:
        - configMapRef:
            name: gami-config
        image: ghcr.io/authenticmemory/gami-webapp:latest
        livenessProbe:
          httpGet:
            path: /api/public/health
            port: http
          initialDelaySeconds: 10
          periodSeconds: 15
        name: gami-webapp
        ports:
        - containerPort: 3000
          name: http
        readinessProbe:
          httpGet:
            path: /api/public/health
            port: http
          initialDelaySeconds: 5
          periodSeconds: 10
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 256Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 65532
          runAsNonRoot: true
          runAsUser: 65532
        volumeMounts:
        - mountPath: /tmp
          name: tmp
      imagePullSecrets:
      - name: ghcr-pull-secret
      volumes:
      - emptyDir: {}
        name: tmp
---
apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
  name: gami-migrate
  namespace: gami-staging
spec:
  backoffLimit: 3
  template:
    spec:
      containers:
      - command:
        - npm
        - run
        - db:setup
        env:
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              key: uri
              name: gami-postgres-app
        envFrom:
        - configMapRef:
            name: gami-config
        image: ghcr.io/authenticmemory/gami-webapp:latest-migrate
        name: gami-migrate
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 256Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          runAsNonRoot: true
          runAsUser: 1000
      imagePullSecrets:
      - name: ghcr-pull-secret
      restartPolicy: Never
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-staging
  name: gami-webapp
  namespace: gami-staging
spec:
  ingressClassName: traefik
  rules:
  - host: staging.authenticmemory.org
    http:
      paths:
      - backend:
          service:
            name: gami-webapp
            port:
              number: 3000
        path: /
        pathType: Prefix
  - host: verify-staging.authenticmemory.org
    http:
      paths:
      - backend:
          service:
            name: gami-webapp
            port:
              number: 3000
        path: /
        pathType: Prefix
  tls:
  - hosts:
    - staging.authenticmemory.org
    - verify-staging.authenticmemory.org
    secretName: gami-webapp-tls
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: gami-postgres
  namespace: gami-staging
spec:
  affinity:
    nodeSelector:
      env: staging
  bootstrap:
    initdb:
      database: gami_staging
      owner: gami
  instances: 1
  postgresql:
    pg_hba:
    - host gami_staging gami 10.0.0.0/8 scram-sha-256
  storage:
    size: 5Gi
    storageClass: longhorn
